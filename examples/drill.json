{
  "config_name": "drill_example",
  "config_version": "1.0",
  "mode": "drill",
  "sources": [
    "media/source_1.mp4",
    "media/source_2.mp4"
  ],
  "audio": "media/song.mp3",
  "cut_frequency": 0.6,
  "max_consecutive_same_source": 2,
  "alternation_variation": 0.15,
  "bpm_override": 0,
  "bass_hit_amplitude_threshold": 0.7,
  "clip_selection": "random",
  "avoid_clip_repeat": true,
  "long_clip_sampling_strategy": "distributed",
  "ffmpeg_filter": "eq=saturation=0.88:contrast=1.05,colorchannelmixer=rr=0.95:gg=0.98:bb=1.05,curves=all='0/0.039 1/0.961',colortemperature=temperature=7200",
  "aspect_ratio": "9:16",
  "output_resolution": "1080x1920",
  "output_frame_rate": 30,
  "output_bitrate": "8M",
  "render_quality_tier": "draft",
  "audio_fade_in_duration": 0.3,
  "audio_fade_out_duration": 0.5,
  "audio_start_offset": 0,
  "audio_end_offset": 0
}
