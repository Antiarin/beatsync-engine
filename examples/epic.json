{
  "config_name": "epic_example",
  "config_version": "1.0",
  "mode": "epic",
  "sources": [
    "media/source_1.mp4",
    "media/source_2.mp4",
    "media/source_3.mp4",
    "media/source_4.mp4"
  ],
  "source_weights": [0.3, 0.3, 0.2, 0.2],
  "audio": "media/song.mp3",
  "cut_frequency": 0.45,
  "max_consecutive_same_source": 3,
  "alternation_variation": 0.25,
  "bpm_override": 0,
  "bass_hit_amplitude_threshold": 0.6,
  "clip_selection": "random",
  "avoid_clip_repeat": true,
  "long_clip_sampling_strategy": "distributed",
  "ffmpeg_filter": "eq=saturation=0.85:contrast=1.08,colortemperature=temperature=5800",
  "aspect_ratio": "9:16",
  "output_resolution": "1080x1920",
  "output_frame_rate": 30,
  "output_bitrate": "10M",
  "render_quality_tier": "final_bake",
  "audio_fade_in_duration": 1.0,
  "audio_fade_out_duration": 2.0,
  "audio_start_offset": 0,
  "audio_end_offset": 0
}
